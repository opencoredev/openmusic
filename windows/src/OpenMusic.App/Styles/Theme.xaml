<?xml version="1.0" encoding="utf-8"?>
<!-- Shared look: sizes, brushes and text styles on top of the Windows 11 type ramp (Segoe UI Variable) and the system
     accent color. Pages and controls use these keys; change the look here, not per page. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PlayerBarBackgroundBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="SidePaneBackgroundBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="ArtworkPlaceholderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="#66000000" />
            <SolidColorBrush x:Key="NowPlayingScrimBrush" Color="#66000000" />
            <Color x:Key="SnapshotBackdropColor">#FFF0F2F5</Color>
            <!-- The first run's card, its art pane (a wash of the app icon's pink and blue) and the art's round plates. -->
            <SolidColorBrush x:Key="OnboardingCardBrush" Color="#FFFDFDFD" />
            <LinearGradientBrush x:Key="OnboardingArtBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFBE9F4" Offset="0" />
                <GradientStop Color="#FFE8EDFC" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="OnboardingPlateBrush" Color="#FFFFFFFF" />
            <StaticResource x:Key="OnboardingAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="OnboardingOnAccentBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="OnboardingPipOffBrush" ResourceKey="ControlStrongFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PlayerBarBackgroundBrush" Color="#4D1C1C1C" />
            <SolidColorBrush x:Key="SidePaneBackgroundBrush" Color="#33000000" />
            <SolidColorBrush x:Key="ArtworkPlaceholderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="NowPlayingScrimBrush" Color="#80000000" />
            <Color x:Key="SnapshotBackdropColor">#FF1F1F24</Color>
            <SolidColorBrush x:Key="OnboardingCardBrush" Color="#FF2B2B2B" />
            <LinearGradientBrush x:Key="OnboardingArtBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF3A2638" Offset="0" />
                <GradientStop Color="#FF222B42" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="OnboardingPlateBrush" Color="#FF3B3B41" />
            <StaticResource x:Key="OnboardingAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="OnboardingOnAccentBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="OnboardingPipOffBrush" ResourceKey="ControlStrongFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PlayerBarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SidePaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ArtworkPlaceholderBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="NowPlayingScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <Color x:Key="SnapshotBackdropColor">#FF000000</Color>
            <SolidColorBrush x:Key="OnboardingCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OnboardingArtBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OnboardingPlateBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OnboardingAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OnboardingOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="OnboardingPipOffBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Sizes -->
    <x:Double x:Key="CardArtworkSize">172</x:Double>
    <x:Double x:Key="CardWidth">172</x:Double>
    <!-- Grids of cards (Albums, Artists, Recently Added, Radio): the same 16 px gutters as the shelves, 24 px between rows. -->
    <Style x:Key="CardGridItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Margin" Value="0,0,16,24" />
    </Style>
    <x:Double x:Key="HeroCardWidth">300</x:Double>
    <x:Double x:Key="ArtistCardSize">148</x:Double>
    <x:Double x:Key="TrackRowArtworkSize">40</x:Double>
    <x:Double x:Key="PlayerBarHeight">88</x:Double>
    <x:Double x:Key="SidePaneWidth">360</x:Double>
    <CornerRadius x:Key="ArtworkCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SmallArtworkCornerRadius">4</CornerRadius>
    <Thickness x:Key="PagePadding">36,20,36,32</Thickness>
    <Thickness x:Key="ShelfHeaderMargin">0,28,0,10</Thickness>

    <!-- Text -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ShelfTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <!-- Card titles under artwork: up to two lines in a fixed 40 px area, so a row of cards lines up. -->
    <Style x:Key="CardTwoLineTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="Height" Value="40" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="CardSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="SecondaryBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TimeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Transport buttons: borderless, round hover, Segoe Fluent Icons. -->
    <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="TransportToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="PlayPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="BarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="BarIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource TransportToggleButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Lyrics -->
    <Style x:Key="LyricLineTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style x:Key="LargeLyricLineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LyricLineTextStyle}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="44" />
    </Style>

    <!-- A ListViewItem without the selection pill, for track and lyric rows that only take clicks. -->
    <Style x:Key="PlainListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- For UI built in code. A brush read from Application.Current.Resources is the app theme's (light), not the
         element's; a style whose setters use ThemeResource follows the element's RequestedTheme. -->
    <Style x:Key="OpenMusicSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OpenMusicSecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OpenMusicTertiaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="OpenMusicCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="OpenMusicCardGridStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>
    <Style x:Key="OpenMusicCodeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style x:Key="OpenMusicKeyCapStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2,8,3" />
    </Style>
    <Style x:Key="OpenMusicFrameStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="OpenMusicSolidPanelStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    </Style>
</ResourceDictionary>
