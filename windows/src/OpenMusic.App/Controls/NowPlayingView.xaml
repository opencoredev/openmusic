<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing: the artwork blurred behind everything, the big artwork with the song on the left, large synced lyrics
     on the right. The now-playing bar stays below it for the transport. -->
<UserControl
    x:Class="OpenMusic.App.Controls.NowPlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenMusic.App.Controls"
    xmlns:svc="using:OpenMusic.App.Services"
    RequestedTheme="Dark">

    <Grid x:Name="ViewRoot" Background="#FF101014">
        <!-- Backdrop: the cover decoded tiny and stretched is already soft; in-app acrylic blurs it the rest of the way. -->
        <Image svc:Art.Source="{x:Bind Player.Artwork, Mode=OneWay}" svc:Art.Pixels="64" Stretch="UniformToFill" Opacity="0.9" />
        <Border>
            <Border.Background>
                <AcrylicBrush TintColor="#FF0C0C10" TintOpacity="0.35" TintLuminosityOpacity="0.4" FallbackColor="#B30C0C10" />
            </Border.Background>
        </Border>
        <Border Background="{ThemeResource NowPlayingScrimBrush}" Opacity="0.35" />

        <Grid x:Name="Layout" Padding="56,40,40,24" ColumnSpacing="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtColumn" Width="5*" MaxWidth="560" />
                <ColumnDefinition x:Name="LyricsColumn" Width="6*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ArtPanel" VerticalAlignment="Center" Spacing="6" MaxWidth="480">
                <Border
                    x:Name="Cover"
                    HorizontalAlignment="Stretch"
                    CornerRadius="12">
                    <Border.Background>
                        <ImageBrush svc:Art.Source="{x:Bind Player.Artwork, Mode=OneWay}" svc:Art.Pixels="900" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Grid Margin="0,22,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <Button Grid.Column="1" VerticalAlignment="Top" Margin="0,2,0,0" Style="{StaticResource BarIconButtonStyle}" Foreground="White"
                            Command="{x:Bind Player.ToggleLikeCommand}" Visibility="{x:Bind Player.CanLike, Mode=OneWay}"
                            AutomationProperties.AutomationId="NowPlayingLike" AutomationProperties.Name="{x:Bind Player.LikeLabel, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Player.LikeLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind Player.LikeGlyph, Mode=OneWay}" FontSize="20" />
                    </Button>
                </Grid>
                <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Normal" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Player.SourceLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#99FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <local:LyricsView x:Name="Lyrics" Grid.Column="1" Anchor="0.38" />
        </Grid>

        <Button
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,12,16,0"
            Style="{StaticResource BarIconButtonStyle}"
            Content="&#xE70D;"
            Click="Close_Click"
            AutomationProperties.Name="Close Now Playing"
            ToolTipService.ToolTip="Close (Esc)" />
    </Grid>
</UserControl>
