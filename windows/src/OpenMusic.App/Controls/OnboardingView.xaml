<?xml version="1.0" encoding="utf-8"?>
<!-- The first run, over the whole window below the title bar, in the shape of Windows 11's setup screens: one card on
     Mica with art on the left and the step on the right, the step's buttons at its bottom right. Steps: Welcome, Your
     music, Sync (optional), Approve this PC (only when another device holds the account's key), then Home. Every step
     has a way past it. The flow and its words are shared with the Mac and iPhone apps (onboarding/flow.md). -->
<UserControl
    x:Class="OpenMusic.App.Controls.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="StepTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="StepBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="ServiceRowStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14,16,16" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style x:Key="SignInButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="FooterAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="ArtPlateStyle" TargetType="Border">
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="168" />
            <Setter Property="CornerRadius" Value="84" />
            <Setter Property="Background" Value="{ThemeResource OnboardingPlateBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Progress pips (styles, so their ThemeResource colors follow the view's theme). -->
        <Style x:Key="PipOnStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="6" />
            <Setter Property="RadiusX" Value="3" />
            <Setter Property="RadiusY" Value="3" />
            <Setter Property="Fill" Value="{ThemeResource OnboardingAccentBrush}" />
        </Style>
        <Style x:Key="PipOffStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="RadiusX" Value="3" />
            <Setter Property="RadiusY" Value="3" />
            <Setter Property="Fill" Value="{ThemeResource OnboardingPipOffBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Padding="32,4,32,32">
        <Grid x:Name="Card" MaxWidth="1040" MaxHeight="740" CornerRadius="8" BorderThickness="1"
              Background="{ThemeResource OnboardingCardBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
              Translation="0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtColumn" Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- Art: one picture per step, on a soft wash of the app icon's colors. Decorative: hidden from Narrator. -->
            <Grid x:Name="ArtPane" Background="{ThemeResource OnboardingArtBrush}" AutomationProperties.AccessibilityView="Raw">
                <Image x:Name="WelcomeArt" Source="ms-appx:///Assets/OpenMusic.png" Width="148" Height="148" />
                <Grid x:Name="MusicArt" Visibility="Collapsed" Width="220" Height="200">
                    <Border Style="{StaticResource ArtPlateStyle}" Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ContentPresenter x:Name="YouTubeArt" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource ArtPlateStyle}" Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <ContentPresenter x:Name="SpotifyArt" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Grid x:Name="SyncArt" Visibility="Collapsed" Width="240" Height="190">
                    <Border Style="{StaticResource ArtPlateStyle}" Width="150" Height="150" CornerRadius="75" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE7F8;" FontSize="64" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource ArtPlateStyle}" Width="104" Height="104" CornerRadius="52" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <FontIcon Glyph="&#xE8EA;" FontSize="44" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,52,0,0"
                            Background="{ThemeResource OnboardingAccentBrush}" BorderBrush="{ThemeResource OnboardingPlateBrush}" BorderThickness="3">
                        <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource OnboardingOnAccentBrush}" />
                    </Border>
                </Grid>
                <Grid x:Name="ApproveArt" Visibility="Collapsed">
                    <Border Style="{StaticResource ArtPlateStyle}">
                        <FontIcon Glyph="&#xE8D7;" FontSize="68" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="StepPane" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The step's heading stays put; only the form below it scrolls. -->
                <StackPanel x:Name="StepHeader" Padding="44,48,44,0" Visibility="Collapsed">
                    <TextBlock x:Name="StepEyebrow" Text="Optional OpenMusic account" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" Margin="0,0,0,4" Visibility="Collapsed" AutomationProperties.AutomationId="OnboardingEyebrow" />
                    <TextBlock x:Name="StepTitle" Style="{StaticResource StepTitleStyle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="OnboardingTitle" />
                    <TextBlock x:Name="StepBody" Style="{StaticResource StepBodyStyle}" Margin="0,0,0,16" AutomationProperties.AutomationId="OnboardingBody" />
                    <TextBlock x:Name="StepNote" Style="{StaticResource OpenMusicSecondaryTextStyle}" Margin="0,-8,0,16" Visibility="Collapsed"
                               AutomationProperties.AutomationId="OnboardingNote" Text="This account is for sync, separate from your music sign-in." />
                </StackPanel>
                <!-- A hairline under the heading while the form is scrolled, so the form reads as passing under it. -->
                <Rectangle x:Name="HeaderDivider" Grid.Row="1" Height="1" VerticalAlignment="Top" Margin="44,0,44,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                           Visibility="Collapsed" Canvas.ZIndex="1" />
                <ScrollViewer x:Name="StepScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" IsTabStop="False"
                              ViewChanged="StepScroller_ViewChanged">
                    <Grid x:Name="StepHost" Padding="44,48,44,20">

                        <!-- 1. Welcome -->
                        <StackPanel x:Name="WelcomeStep" VerticalAlignment="Center" Spacing="10" Margin="0,0,0,24">
                            <Image x:Name="WelcomeSmallIcon" Source="ms-appx:///Assets/OpenMusic.png" Width="64" Height="64" HorizontalAlignment="Left" Visibility="Collapsed"
                                   Margin="0,0,0,8" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="WelcomeTitle" Text="OpenMusic" Style="{StaticResource TitleLargeTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="WelcomeLine" Style="{StaticResource StepBodyStyle}" FontSize="18" MaxWidth="440" HorizontalAlignment="Left"
                                       Text="YouTube Music in one fast player, on all your devices." />
                        </StackPanel>

                        <!-- 2. Your music -->
                        <StackPanel x:Name="MusicStep" Visibility="Collapsed" Spacing="0">

                            <Grid x:Name="YouTubeRow" Style="{StaticResource ServiceRowStyle}" AutomationProperties.Name="YouTube Music">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="YouTubeMark" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="YouTube Music" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="YouTubeDoneIcon" Glyph="&#xEC61;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"
                                                  VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="YouTubeStatus" Grid.Column="1" Style="{StaticResource OpenMusicSecondaryCaptionStyle}" FontSize="13" AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.AutomationId="OnboardingYouTubeStatus"
                                                   Text="Works without an account. Sign in to bring your library, likes and playlists." />
                                    </Grid>
                                    <StackPanel x:Name="YouTubeButtons" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" SizeChanged="YouTubeButtons_SizeChanged">
                                        <Button x:Name="YouTubeSignInButton" Click="YouTubeSignIn_Click" AutomationProperties.AutomationId="OnboardingYouTubeSignIn"
                                                AutomationProperties.Name="Sign in to YouTube Music with Google">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ContentPresenter x:Name="YouTubeGoogleMark" VerticalAlignment="Center" />
                                                <TextBlock Text="Sign in with Google" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="SpotifyRow" Style="{StaticResource ServiceRowStyle}" Margin="0,8,0,0" AutomationProperties.Name="Spotify">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="SpotifyMark" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Spotify" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Style="{StaticResource OpenMusicSecondaryCaptionStyle}" FontSize="13" AutomationProperties.AutomationId="OnboardingSpotifyStatus"
                                               Text="Coming to OpenMusic for Windows. Playback needs Spotify Premium." />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,2,8,3" CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="Coming soon" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- 3. Sync (optional) -->
                        <StackPanel x:Name="SyncStep" Visibility="Collapsed" SizeChanged="SyncStep_SizeChanged">

                            <StackPanel x:Name="SignInChoices" HorizontalAlignment="Left" Spacing="8">
                                <Button x:Name="AppleButton" Style="{StaticResource SignInButtonStyle}" Click="Apple_Click" AutomationProperties.AutomationId="OnboardingApple" AutomationProperties.Name="Continue with Apple">
                                    <Grid>
                                        <ContentPresenter x:Name="AppleMark" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,1" />
                                        <TextBlock Text="Continue with Apple" HorizontalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button x:Name="GoogleButton" Style="{StaticResource SignInButtonStyle}" Click="Google_Click" AutomationProperties.AutomationId="OnboardingGoogle" AutomationProperties.Name="Continue with Google">
                                    <Grid>
                                        <ContentPresenter x:Name="GoogleMark" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <TextBlock Text="Continue with Google" HorizontalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Grid x:Name="OrDivider" ColumnSpacing="12" Margin="0,6,0,2" AutomationProperties.AccessibilityView="Raw">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="or" Style="{StaticResource OpenMusicTertiaryCaptionStyle}" />
                                    <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Email: the address, then the code on the same spot. -->
                                <Grid x:Name="EmailPanel" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EmailBox" Header="Email address" PlaceholderText="name@example.com" AutomationProperties.Name="Email address" AutomationProperties.AutomationId="OnboardingEmail"
                                             TextChanged="EmailBox_TextChanged" KeyDown="EmailBox_KeyDown" IsSpellCheckEnabled="False" />
                                    <Button x:Name="SendCodeButton" Grid.Column="1" Content="Send Code" MinWidth="104" IsEnabled="False" VerticalAlignment="Bottom" Click="SendCode_Click"
                                            AutomationProperties.AutomationId="OnboardingSendCode" />
                                </Grid>
                                <StackPanel x:Name="CodePanel" Visibility="Collapsed" Spacing="8">
                                    <TextBlock x:Name="CodeSentText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OnboardingCodeSent" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CodeBox" Header="6-digit code" PlaceholderText="000 000" MaxLength="12" AutomationProperties.Name="6-digit code" AutomationProperties.AutomationId="OnboardingCode"
                                                 TextChanged="CodeBox_TextChanged" KeyDown="CodeBox_KeyDown" IsSpellCheckEnabled="False" FontSize="16" CharacterSpacing="120" />
                                        <Button x:Name="VerifyButton" Grid.Column="1" Content="Sign In" MinWidth="104" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" VerticalAlignment="Bottom" Click="Verify_Click"
                                                AutomationProperties.AutomationId="OnboardingVerify" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <HyperlinkButton x:Name="ResendButton" Content="Resend code" Padding="0,2" Click="Resend_Click" AutomationProperties.AutomationId="OnboardingResend" />
                                        <TextBlock Text="·" Style="{StaticResource OpenMusicTertiaryCaptionStyle}" VerticalAlignment="Center" Margin="6,0" AutomationProperties.AccessibilityView="Raw" />
                                        <HyperlinkButton x:Name="ChangeEmailButton" Content="Use a different email" Padding="0,2" Click="ChangeEmail_Click" AutomationProperties.AutomationId="OnboardingChangeEmail" />
                                    </StackPanel>
                                </StackPanel>

                                <ProgressBar x:Name="SignInProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,2,0,0" AutomationProperties.Name="Signing in" />
                                <InfoBar x:Name="BrowserBar" Severity="Informational" IsClosable="False" IsOpen="False" AutomationProperties.AutomationId="OnboardingBrowserBar">
                                    <InfoBar.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                            <Button x:Name="BrowserReopenButton" Content="Open Again" Click="BrowserReopen_Click" AutomationProperties.AutomationId="OnboardingBrowserReopen" />
                                            <Button x:Name="BrowserCancelButton" Content="Cancel" Click="BrowserCancel_Click" AutomationProperties.AutomationId="OnboardingBrowserCancel" />
                                        </StackPanel>
                                    </InfoBar.Content>
                                </InfoBar>
                                <InfoBar x:Name="SignInError" Severity="Error" IsClosable="True" IsOpen="False" AutomationProperties.AutomationId="OnboardingSignInError" />
                                <InfoBar x:Name="SignedInBar" Severity="Success" IsClosable="False" IsOpen="False" AutomationProperties.AutomationId="OnboardingSignedIn" />
                            </StackPanel>

                            <!-- What the server sees, in one line. -->
                            <Grid x:Name="PrivacyRow" HorizontalAlignment="Left" ColumnSpacing="10" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="PrivacyLine" Grid.Column="1" Style="{StaticResource OpenMusicSecondaryTextStyle}" AutomationProperties.AutomationId="OnboardingPrivacy"
                                           Text="OpenMusic's server sees when you play and pause, never what you play. Songs, queues and searches are encrypted on your devices." />
                            </Grid>

                            <!-- Use your own server: one field, checked before anything switches. -->
                            <StackPanel x:Name="ServerSection" HorizontalAlignment="Left" Margin="0,12,0,0" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <HyperlinkButton x:Name="ServerLink" Padding="0,2" Click="ServerLink_Click" AutomationProperties.AutomationId="OnboardingServerLink"
                                                     AutomationProperties.Name="Use your own server">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:Name="ServerLinkText" Text="Use your own server" />
                                            <FontIcon x:Name="ServerChevron" Glyph="&#xE70D;" FontSize="10" AutomationProperties.AccessibilityView="Raw" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>
                                <TextBlock x:Name="ServerInUse" Style="{StaticResource OpenMusicSecondaryCaptionStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="OnboardingServerInUse" />
                                <StackPanel x:Name="ServerPanel" Visibility="Collapsed" Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ServerBox" Header="Sync server address" PlaceholderText="https://your-deployment.convex.cloud" AutomationProperties.Name="Sync server address"
                                                 AutomationProperties.AutomationId="OnboardingServerUrl" TextChanged="ServerBox_TextChanged" KeyDown="ServerBox_KeyDown" IsSpellCheckEnabled="False" />
                                        <Button x:Name="CheckServerButton" Grid.Column="1" Content="Check" MinWidth="80" IsEnabled="False" VerticalAlignment="Bottom" Click="CheckServer_Click"
                                                AutomationProperties.AutomationId="OnboardingCheckServer" />
                                    </Grid>
                                    <StackPanel x:Name="ServerChecking" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                        <ProgressRing IsActive="True" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="ServerCheckingText" Style="{StaticResource OpenMusicSecondaryCaptionStyle}" FontSize="13" AutomationProperties.LiveSetting="Polite"
                                                   VerticalAlignment="Center" AutomationProperties.AutomationId="OnboardingServerChecking" />
                                        <HyperlinkButton x:Name="CancelCheckButton" Content="Cancel" Padding="4,0" FontSize="13" Click="CancelCheck_Click"
                                                         AutomationProperties.AutomationId="OnboardingCancelCheck" />
                                    </StackPanel>
                                    <InfoBar x:Name="ServerResult" IsClosable="False" IsOpen="False" AutomationProperties.AutomationId="OnboardingServerResult">
                                        <InfoBar.ActionButton>
                                            <Button x:Name="UseServerButton" Content="Use This Server" Click="UseServer_Click" AutomationProperties.AutomationId="OnboardingUseServer" />
                                        </InfoBar.ActionButton>
                                    </InfoBar>
                                    <TextBlock Style="{StaticResource OpenMusicTertiaryCaptionStyle}" TextWrapping="Wrap"
                                               Text="Everyone on your server signs in there. OpenMusic's server isn't used." />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. Approve this PC -->
                        <StackPanel x:Name="ApproveStep" Visibility="Collapsed">
                            <TextBlock x:Name="ApproveWhy" Style="{StaticResource OpenMusicSecondaryTextStyle}" MaxWidth="460" HorizontalAlignment="Left" Margin="0,0,0,24"
                                       AutomationProperties.AutomationId="OnboardingApproveWhy"
                                       Text="Your YouTube Music and Spotify sign-ins are encrypted with a key only your devices hold. Approving gives this PC that key." />
                            <StackPanel x:Name="ApproveWaiting" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                                <ProgressRing IsActive="True" Width="20" Height="20" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="ApproveWaitingText" Style="{StaticResource OpenMusicSecondaryTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.AutomationId="OnboardingApproveWaiting" />
                            </StackPanel>
                            <TextBlock x:Name="ApproveWaitingHint" Style="{StaticResource OpenMusicSecondaryCaptionStyle}" MaxWidth="460" HorizontalAlignment="Left" Margin="32,8,0,0"
                                       Visibility="Collapsed" AutomationProperties.AutomationId="OnboardingApproveHint" />
                            <StackPanel x:Name="ApproveCompare" Visibility="Collapsed" Spacing="16" MaxWidth="420" HorizontalAlignment="Left">
                                <Border Style="{StaticResource OpenMusicCodeCardStyle}" Padding="24,14" HorizontalAlignment="Left">
                                    <TextBlock x:Name="ApproveCode" FontFamily="Segoe UI Variable Display" FontSize="48" FontWeight="SemiBold" CharacterSpacing="80"
                                               AutomationProperties.AutomationId="OnboardingApproveCode" />
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing x:Name="ApproveSpinner" IsActive="False" Width="16" Height="16" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,2,10,0"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Name="ApproveInstructions" Grid.Column="1" Style="{StaticResource OpenMusicSecondaryTextStyle}" AutomationProperties.LiveSetting="Polite"
                                               AutomationProperties.AutomationId="OnboardingApproveInstructions" />
                                </Grid>
                                <StackPanel x:Name="ApproveAnswers" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CodesMatchButton" Content="Codes Match" Style="{StaticResource AccentButtonStyle}" MinWidth="140" Click="CodesMatch_Click"
                                            AutomationProperties.AutomationId="OnboardingCodesMatch" />
                                    <Button x:Name="CodesDontMatchButton" Content="Codes Don't Match" MinWidth="140" Click="CodesDontMatch_Click"
                                            AutomationProperties.AutomationId="OnboardingCodesDontMatch" />
                                </StackPanel>
                            </StackPanel>
                            <InfoBar x:Name="ApproveProblem" Severity="Warning" IsClosable="False" IsOpen="False" MaxWidth="420" HorizontalAlignment="Left" Margin="0,16,0,0"
                                     AutomationProperties.AutomationId="OnboardingApproveProblem">
                                <InfoBar.ActionButton>
                                    <Button x:Name="AskAgainButton" Content="Ask Again" Click="AskAgain_Click" AutomationProperties.AutomationId="OnboardingAskAgain" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <!-- What Do This Later means. -->
                            <Grid x:Name="ApproveLaterNote" ColumnSpacing="10" Margin="0,28,0,0" MaxWidth="460" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" FontSize="14" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Style="{StaticResource OpenMusicSecondaryCaptionStyle}" AutomationProperties.AutomationId="OnboardingApproveLater"
                                           Text="Choose Do This Later to start listening. Until this PC is approved, your sign-ins and what plays on your other devices stay locked here; a banner on Home and Settings › Account let you finish." />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- The step's buttons, bottom right, as in Windows setup; where you are, bottom left. -->
                <Grid x:Name="Footer" Grid.Row="2" Padding="44,12,44,28" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Pips" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" AutomationProperties.AutomationId="OnboardingProgress" />
                    <Button x:Name="SecondaryButton" Grid.Column="1" Style="{StaticResource FooterButtonStyle}" Click="Secondary_Click" AutomationProperties.AutomationId="OnboardingSecondary" />
                    <Button x:Name="PrimaryButton" Grid.Column="2" Style="{StaticResource FooterAccentButtonStyle}" Click="Primary_Click" AutomationProperties.AutomationId="OnboardingPrimary" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
