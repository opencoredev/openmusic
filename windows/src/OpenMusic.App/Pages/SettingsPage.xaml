<?xml version="1.0" encoding="utf-8"?>
<!-- Settings in Windows 11 settings-card style: Account (OpenMusic), YouTube Music, Playback, Appearance, About.
     The account sections are filled in code (SettingsPage.xaml.cs) since they change with the sign-ins. -->
<Page
    x:Class="OpenMusic.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="SettingCardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,24,0,6" />
        </Style>
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="4" MaxWidth="1072" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,4" />

            <TextBlock Text="OpenMusic account" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,6" />
            <StackPanel x:Name="AccountSection" Spacing="4" AutomationProperties.AutomationId="AccountSection" />

            <TextBlock Text="YouTube Music" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel x:Name="YouTubeSection" Spacing="4" AutomationProperties.AutomationId="YouTubeSection" />

            <TextBlock Text="Playback" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8EE;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Autoplay" />
                    <TextBlock Text="Keep playing similar songs when the queue ends. Follows your OpenMusic account." Style="{StaticResource CardCaptionStyle}" />
                </StackPanel>
                <ToggleSwitch x:Name="AutoplaySwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="AutoplaySwitch_Toggled" AutomationProperties.AutomationId="AutoplaySwitch" />
            </Grid>
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE995;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Sound Check" />
                    <TextBlock Text="Play songs at a similar loudness" Style="{StaticResource CardCaptionStyle}" />
                </StackPanel>
                <ToggleSwitch x:Name="SoundCheckSwitch" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="SoundCheckSwitch_Toggled" />
            </Grid>
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE93E;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Stream format" />
                    <TextBlock x:Name="StreamCaption" Text="Which kind of YouTube stream to try first. Applies the next time OpenMusic starts." Style="{StaticResource CardCaptionStyle}" />
                </StackPanel>
                <ComboBox x:Name="StreamBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="StreamBox_SelectionChanged" AutomationProperties.AutomationId="StreamBox">
                    <ComboBoxItem Content="Direct (AAC, recommended)" Tag="direct" />
                    <ComboBoxItem Content="HLS" Tag="hls" />
                </ComboBox>
            </Grid>

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE790;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="App theme" />
                    <TextBlock Text="Light, dark, or follow Windows" Style="{StaticResource CardCaptionStyle}" />
                </StackPanel>
                <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="ThemeBox_SelectionChanged" AutomationProperties.AutomationId="ThemeBox">
                    <ComboBoxItem Content="Use system setting" Tag="system" />
                    <ComboBoxItem Content="Light" Tag="light" />
                    <ComboBoxItem Content="Dark" Tag="dark" />
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE765;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Keyboard shortcuts" />
                    <TextBlock Text="Ctrl+/ shows them any time" Style="{StaticResource CardCaptionStyle}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Show" MinWidth="96" Click="Shortcuts_Click" AutomationProperties.AutomationId="ShowShortcuts" />
            </Grid>

            <TextBlock x:Name="AboutHeader" Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/OpenMusic.png" Width="32" Height="32" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="OpenMusic" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CardCaptionStyle}" />
                    <TextBlock Style="{StaticResource CardCaptionStyle}" Text="A native player for YouTube Music. Not affiliated with YouTube or Google." />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
