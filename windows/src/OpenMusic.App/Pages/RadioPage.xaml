<?xml version="1.0" encoding="utf-8"?>
<!-- Radio: stations from artists and mixes. A station plays a radio seeded by it. -->
<Page
    x:Class="OpenMusic.App.Pages.RadioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenMusic.App.Controls"
    xmlns:vm="using:OpenMusic.App.ViewModels"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <DataTemplate x:Key="StationTemplate" x:DataType="vm:CardItem">
            <Grid Width="220" Height="140" CornerRadius="{StaticResource ArtworkCornerRadius}">
                <controls:ArtworkView Source="{x:Bind Artwork}" Pixels="300" CornerRadius="{StaticResource ArtworkCornerRadius}" />
                <Border CornerRadius="{StaticResource ArtworkCornerRadius}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#33000000" />
                            <GradientStop Offset="1" Color="#D9000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Bottom" Padding="14,0,14,12">
                    <TextBlock Text="{x:Bind Title}" Foreground="White" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Foreground="#CCFFFFFF" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <FontIcon Glyph="&#xEC05;" Foreground="White" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}">
            <StackPanel Padding="0,0,0,8" Spacing="4">
                <TextBlock Text="Radio" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Endless stations from a song, an artist or a mix. Autoplay keeps them going." Style="{StaticResource SecondaryBodyTextStyle}" />
            </StackPanel>
            <TextBlock x:Name="RecentHeader" Text="Your Stations" Style="{StaticResource ShelfTitleTextStyle}" Margin="0,20,0,12" Visibility="Collapsed" />
            <GridView x:Name="Recent" Margin="-4,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Stations_ItemClick"
                      ItemTemplate="{StaticResource StationTemplate}" ItemContainerStyle="{StaticResource CardGridItemStyle}" AutomationProperties.AutomationId="RecentStations" />
            <TextBlock x:Name="SuggestedHeader" Text="Start a Station" Style="{StaticResource ShelfTitleTextStyle}" Margin="0,20,0,12" />
            <GridView x:Name="Stations" Margin="-4,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Stations_ItemClick"
                      ItemTemplate="{StaticResource StationTemplate}" ItemContainerStyle="{StaticResource CardGridItemStyle}" AutomationProperties.AutomationId="Stations" />
            <ProgressRing x:Name="Loading" IsActive="False" Visibility="{x:Bind Loading.IsActive, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,24,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
