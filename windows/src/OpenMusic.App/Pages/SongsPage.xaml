<?xml version="1.0" encoding="utf-8"?>
<!-- Library › Songs and Liked Songs: a long, virtualized list with Play and Shuffle. -->
<Page
    x:Class="OpenMusic.App.Pages.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenMusic.App.Controls"
    NavigationCacheMode="Enabled">
    <controls:TrackList x:Name="SongsList">
        <controls:TrackList.Header>
            <StackPanel Padding="8,20,8,12" Spacing="4">
                <TextBlock x:Name="Heading" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryBodyTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,8">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="Play_Click" MinWidth="112">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button Click="Shuffle_Click" MinWidth="112">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            <TextBlock Text="Shuffle" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid ColumnSpacing="14" Padding="0,8,0,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Album" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon Grid.Column="3" Glyph="&#xE823;" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </controls:TrackList.Header>
    </controls:TrackList>
</Page>
