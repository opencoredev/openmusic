<Project Sdk="Microsoft.NET.Sdk">
  <!-- YouTube Music through InnerTube, ported from Sources/YouTubeMusicKit. Cross-platform (builds and tests on Linux),
       no Windows dependency and no third-party packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenMusic.Providers.YouTube</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Core's list, plus CA5350: SAPISIDHASH is SHA-1 by protocol. -->
    <NoWarn>$(NoWarn);CA1711;CA1716;CA1720;CA1724;CA1034;CA1062;CA2225;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1056;CA1054;CA1055;CA1002;CA1819;CA1003;CA1008;CA1028;CA1027;CA1200;CA1051;CA1815;CA1000;CA1031;CA5394;CA1848;CA1805;CA1822;CA1859;CA1860;CA1862;CA1865;CA1866;CA1847;CA2201;CA1063;CA1816;CA1001;CA2000;CA1032;CA1064;CA1812;CA1033;CA1823;CA1725;CA1050;CA1826;CA1861;CA1508;CA5350</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenMusic.Core\OpenMusic.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenMusic.Providers.YouTube.Tests" />
    <InternalsVisibleTo Include="openmusic-probe" />
  </ItemGroup>
</Project>
