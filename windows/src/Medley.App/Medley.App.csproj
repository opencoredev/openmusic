<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: WinUI 3 (Windows App SDK 1.8), unpackaged and self-contained, x64 and arm64.
       Builds on Windows only (the XAML compiler is a Windows tool). On Linux, build and test Medley.Core instead. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Medley.App</RootNamespace>
    <AssemblyName>OpenMusic</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Medley.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Lays out the app's PRI and compiled XAML (.xbf) in a publish; without it `dotnet publish` leaves them out and
         the first page fails to load. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!-- Release publishes are trimmed, partially: the framework, the Windows and WinUI projections, and the libraries
         marked trimmable (Medley.Core and the YouTube provider are IsAotCompatible); the app and Medley.Sync keep
         everything. Medley.Sync's JSON is reflection-based and the taskbar buttons and app identity use built-in COM
         ([ComImport]), so both stay on. See windows/AGENTS.md "Publish size". -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release' and '$(PublishTrimmed)' == ''">true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs is the entry point: single instance, and openmusic:// links handed to the running app. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <NoWarn>$(NoWarn);CA1001;CA1002;CA1003;CA1031;CA1034;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1515;CA1707;CA1716;CA1724;CA1805;CA1812;CA1822;CA1848;CA1859;CA1861;CA2000;CA2007;CA5392;CA1806;CA1508;CA1826;CA2201;CA1063;CA1816;CA1051;CA1823;CA1849;CA1311;CA1304;CA1056;CA1054;CA1819;CA1401;CA1060;CA1069;CA2101;CA1838;CA1308;CA5394;CA1711;CA1720;CA1725;CA1008;CA1027;CA1028;CA1815;CA1024;CA1040;MVVMTK0045;CsWinRT1028;CsWinRT1030;CA1416;SYSLIB1054</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Medley.Core\Medley.Core.csproj" />
    <ProjectReference Include="..\Medley.Providers.YouTube\Medley.Providers.YouTube.csproj" />
    <ProjectReference Include="..\Medley.Sync\Medley.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.png;Assets\**\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- ReadyToRun doubles an assembly's size. The three largest are mostly projections Medley calls a little of (the
       Windows SDK projection, 25 MB of IL, 55 MB compiled; WinUI's, 7 → 16 MB) and BouncyCastle (X25519 at sign-in,
       5 → 11 MB): they stay IL and the few methods used are compiled on first use. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll;Microsoft.WinUI.dll;BouncyCastle.Cryptography.dll" />
  </ItemGroup>
  <!-- The 1.8 metapackage ships the Windows AI runtime (onnxruntime, DirectML: 38 MB), the AI and ML projections, Widgets
       and workload components into every self-contained publish, plus a PDB reader. Medley uses none of them (none is
       activated: checked screen by screen in the VM), so they're left out. -->
  <Target Name="MedleyDropUnusedAiRuntime" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'onnxruntime.dll' or '%(Filename)%(Extension)' == 'DirectML.dll'
        or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.AI.')) or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.ML.'))
        or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.Widgets')) or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.Workloads'))
        or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64' or '%(Filename)' == 'Microsoft.DiaSymReader.Native.arm64' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
