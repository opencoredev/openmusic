<?xml version="1.0" encoding="utf-8"?>
<!-- A list of songs: numbered (album) or with covers (playlist, search, library). Clicking a row plays the list from
     there. With a Header it is the page's scroller (virtualized); without, it sizes to its rows inside a page. -->
<UserControl
    x:Class="Medley.App.Controls.TrackList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Medley.App.Controls"
    xmlns:vm="using:Medley.App.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="NumberedTemplate" x:DataType="vm:TrackRow">
            <Grid Height="48" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Number}" Style="{StaticResource TimeTextStyle}" HorizontalAlignment="Right"
                           Visibility="{x:Bind controls:TrackList.Not(IsCurrent), Mode=OneWay}" />
                <FontIcon Glyph="{x:Bind IndicatorGlyph, Mode=OneWay}" FontSize="14" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                <!-- A Grid, not a horizontal StackPanel, so the title trims against its column; the explicit mark comes first. -->
                <Grid Grid.Column="1" ColumnSpacing="{x:Bind controls:TrackList.BadgeGap(IsExplicit)}" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind Title}"
                               FontWeight="{x:Bind controls:TrackList.Weight(IsCurrent), Mode=OneWay}" />
                    <Border Visibility="{x:Bind IsExplicit}" Padding="4,0" CornerRadius="2" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" VerticalAlignment="Center">
                        <TextBlock Text="E" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
                <TextBlock Grid.Column="2" Text="{x:Bind Artist}" Style="{StaticResource CardSubtitleTextStyle}" VerticalAlignment="Center" MaxWidth="220"
                           Visibility="{x:Bind ShowArtist}" />
                <TextBlock Grid.Column="3" Text="{x:Bind DurationText, Mode=OneWay}" Style="{StaticResource TimeTextStyle}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CoverTemplate" x:DataType="vm:TrackRow">
            <Grid Height="56" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <controls:ArtworkView Width="40" Height="40" Source="{x:Bind Artwork}" Pixels="64" CornerRadius="{StaticResource SmallArtworkCornerRadius}" />
                <Border Width="40" Height="40" CornerRadius="{StaticResource SmallArtworkCornerRadius}" Background="#99000000" Visibility="{x:Bind IsCurrent, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind IndicatorGlyph, Mode=OneWay}" FontSize="14" Foreground="White" />
                </Border>
                <!-- With no album to show, the title takes the album's column too. -->
                <StackPanel Grid.Column="1" Grid.ColumnSpan="{x:Bind controls:TrackList.TitleSpan(Album)}" VerticalAlignment="Center">
                    <Grid ColumnSpacing="{x:Bind controls:TrackList.BadgeGap(IsExplicit)}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind Title}"
                                   FontWeight="{x:Bind controls:TrackList.Weight(IsCurrent), Mode=OneWay}" />
                        <Border Visibility="{x:Bind IsExplicit}" Padding="4,0" CornerRadius="2" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" VerticalAlignment="Center">
                            <TextBlock Text="E" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CardSubtitleTextStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Album}" Style="{StaticResource CardSubtitleTextStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind DurationText, Mode=OneWay}" Style="{StaticResource TimeTextStyle}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ListView
        x:Name="List"
        SelectionMode="None"
        IsItemClickEnabled="True"
        ItemClick="List_ItemClick"
        ItemTemplate="{StaticResource CoverTemplate}"
        ItemContainerStyle="{StaticResource PlainListViewItemStyle}"
        AutomationProperties.Name="Songs" />
</UserControl>
