<?xml version="1.0" encoding="utf-8"?>
<!-- Synced lyrics: the current line is highlighted and kept in view; clicking a line seeks there. Used in the side pane
     and, large, in Now Playing. -->
<UserControl
    x:Class="Medley.App.Controls.LyricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Medley.App.Controls"
    xmlns:vm="using:Medley.App.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="LineTemplate" x:DataType="vm:LyricRow">
            <TextBlock
                Text="{x:Bind Text}"
                Style="{StaticResource LyricLineTextStyle}"
                Opacity="{x:Bind local:LyricsView.LineOpacity(IsCurrent, IsPast), Mode=OneWay}"
                Padding="0,6" />
        </DataTemplate>
        <DataTemplate x:Key="LargeLineTemplate" x:DataType="vm:LyricRow">
            <TextBlock
                Text="{x:Bind Text}"
                Style="{StaticResource LargeLyricLineTextStyle}"
                Opacity="{x:Bind local:LyricsView.LineOpacity(IsCurrent, IsPast), Mode=OneWay}"
                Padding="0,10" />
        </DataTemplate>
        <Style x:Key="LyricItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ListView
            x:Name="Lines"
            ItemsSource="{x:Bind ViewModel.LyricLines}"
            ItemTemplate="{StaticResource LineTemplate}"
            ItemContainerStyle="{StaticResource LyricItemStyle}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="Lines_ItemClick"
            Padding="0,24,0,160"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            AutomationProperties.Name="Lyrics" />
        <TextBlock
            x:Name="Status"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{x:Bind ViewModel.LyricsStatus, Mode=OneWay}"
            Style="{StaticResource SecondaryBodyTextStyle}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Visibility="{x:Bind local:LyricsView.StatusVisibility(ViewModel.HasLyrics, ViewModel.LyricsStatus), Mode=OneWay}" />
    </Grid>
</UserControl>
