<?xml version="1.0" encoding="utf-8"?>
<!-- The mini player's content: the cover filling the window, the song over a gradient, and the transport. -->
<UserControl
    x:Class="Medley.App.Controls.MiniPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Medley.App.Controls"
    RequestedTheme="Dark">

    <Grid x:Name="MiniRoot" Background="#FF141418">
        <controls:ArtworkView Source="{x:Bind Player.Artwork, Mode=OneWay}" Pixels="600" />
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#66000000" />
                    <GradientStop Offset="0.3" Color="#00000000" />
                    <GradientStop Offset="0.55" Color="#33000000" />
                    <GradientStop Offset="1" Color="#E6000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Drag region (the window has no title bar of its own). -->
        <Grid x:Name="DragRegion" Height="40" VerticalAlignment="Top" Background="Transparent" />

        <Button
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="8"
            Style="{StaticResource BarIconButtonStyle}"
            Foreground="White"
            Content="&#xE73F;"
            Click="BackToMain_Click"
            AutomationProperties.Name="Back to OpenMusic"
            ToolTipService.ToolTip="Back to OpenMusic" />

        <StackPanel VerticalAlignment="Bottom" Padding="16,0,16,12" Spacing="2">
            <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" Foreground="White" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Foreground="#CCFFFFFF" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Margin="0,8,0,2" Minimum="0" Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.Position, Mode=OneWay}" Foreground="White" Background="#40FFFFFF" />
            <Grid>
                <TextBlock Text="{x:Bind Player.PositionText, Mode=OneWay}" Style="{StaticResource TimeTextStyle}" Foreground="#CCFFFFFF" FontSize="12" HorizontalAlignment="Left" />
                <TextBlock Text="{x:Bind Player.DurationText, Mode=OneWay}" Style="{StaticResource TimeTextStyle}" Foreground="#CCFFFFFF" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                <Button Style="{StaticResource TransportButtonStyle}" Foreground="White" Content="&#xE892;" Command="{x:Bind Player.PreviousCommand}" AutomationProperties.Name="Previous" />
                <Button x:Name="PlayButton" Style="{StaticResource TransportButtonStyle}" Foreground="White" Width="44" Height="44" CornerRadius="22" FontSize="20"
                        Background="#33FFFFFF"
                        Content="{x:Bind Player.PlayPauseGlyphText, Mode=OneWay}" Command="{x:Bind Player.PlayPauseCommand}"
                        AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}" />
                <Button Style="{StaticResource TransportButtonStyle}" Foreground="White" Content="&#xE893;" Command="{x:Bind Player.NextCommand}" AutomationProperties.Name="Next" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
