<?xml version="1.0" encoding="utf-8"?>
<!-- An album: cover and title, Play and Shuffle, the numbered songs, release notes, more by the artist. -->
<Page
    x:Class="Medley.App.Pages.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Medley.App.Controls">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="0">
            <Grid x:Name="Header" ColumnSpacing="28" Margin="0,8,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:ArtworkView x:Name="Cover" Width="232" Height="232" CornerRadius="{StaticResource ArtworkCornerRadius}"
                                      Source="{x:Bind ViewModel.Artwork, Mode=OneWay}" Pixels="400" />
                <StackPanel x:Name="HeaderText" Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock x:Name="TitleText" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton Padding="0" Click="Artist_Click">
                        <TextBlock Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Normal" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </HyperlinkButton>
                    <TextBlock Text="{x:Bind ViewModel.Meta, Mode=OneWay}" Style="{StaticResource SecondaryBodyTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Play_Click" MinWidth="112" AutomationProperties.AutomationId="AlbumPlay"
                                AutomationProperties.Name="{x:Bind ViewModel.PlayState.Label, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind ViewModel.PlayState.Glyph, Mode=OneWay}" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.PlayState.Label, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ShuffleCommand}" MinWidth="112">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                <TextBlock Text="Shuffle" />
                            </StackPanel>
                        </Button>
                        <Button Content="&#xE712;" FontFamily="{ThemeResource SymbolThemeFontFamily}" AutomationProperties.Name="More"
                                AutomationProperties.AutomationId="AlbumMore" ToolTipService.ToolTip="More" Click="More_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,12" MaxWidth="720" HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.Summary, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" MaxLines="3" LineHeight="20" />
                <HyperlinkButton Content="More" Padding="0,2" Margin="0,2,0,0" Click="MoreSummary_Click" AutomationProperties.AutomationId="AlbumSummaryMore" />
            </StackPanel>

            <controls:TrackList x:Name="Songs" />

            <TextBlock Text="{x:Bind ViewModel.Footnote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="12,16,0,0" LineHeight="18" />

            <controls:ShelfView x:Name="MoreBy" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
