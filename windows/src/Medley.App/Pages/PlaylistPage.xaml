<?xml version="1.0" encoding="utf-8"?>
<!-- A playlist: cover, title, owner and description, Play and Shuffle, and its songs. -->
<Page
    x:Class="Medley.App.Pages.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Medley.App.Controls">
    <Grid>
        <controls:TrackList x:Name="Songs">
            <controls:TrackList.Header>
                <Grid ColumnSpacing="28" Padding="8,28,8,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ArtworkView x:Name="Cover" Width="232" Height="232" CornerRadius="{StaticResource ArtworkCornerRadius}" Source="{x:Bind ViewModel.Artwork, Mode=OneWay}" Pixels="400" />
                    <StackPanel x:Name="HeaderText" Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                        <TextBlock Text="Playlist" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TitleText" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.Owner, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Normal" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock Text="{x:Bind ViewModel.Meta, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="Play_Click" MinWidth="112" AutomationProperties.AutomationId="PlaylistPlay"
                                    AutomationProperties.Name="{x:Bind ViewModel.PlayState.Label, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind ViewModel.PlayState.Glyph, Mode=OneWay}" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.PlayState.Label, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ShuffleCommand}" MinWidth="112">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>
                            <Button Click="More_Click" AutomationProperties.Name="More" AutomationProperties.AutomationId="PlaylistMore" ToolTipService.ToolTip="More">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </controls:TrackList.Header>
        </controls:TrackList>
    </Grid>
</Page>
