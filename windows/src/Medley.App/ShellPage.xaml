<?xml version="1.0" encoding="utf-8"?>
<!-- The app shell: title bar (back, centered search), navigation pane, content frame, the right pane (Lyrics / Up Next),
     Now Playing over the content, and the now-playing bar across the bottom. Screens are pages in Pages/. -->
<Page
    x:Class="Medley.App.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Medley.App.Controls"
    xmlns:vm="using:Medley.App.ViewModels"
    Background="Transparent">

    <!-- Keyboard shortcuts are added in code from Services/Shortcuts.cs, the same list Help › Keyboard Shortcuts shows. -->

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="OpenMusic"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="False"
            IsPaneToggleButtonVisible="True"
            BackRequested="TitleBar_BackRequested"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Medley.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.AutomationId="SearchBox"
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PlaceholderText="Search songs, albums, artists"
                QueryIcon="Find"
                UpdateTextOnSelect="False"
                TextChanged="SearchBox_TextChanged"
                GotFocus="SearchBox_GotFocus"
                SuggestionChosen="SearchBox_SuggestionChosen"
                QuerySubmitted="SearchBox_QuerySubmitted">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchSuggestion">
                        <Grid ColumnSpacing="10" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind QueryGlyph}" FontSize="14" Visibility="{x:Bind IsQuery}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <controls:ArtworkView Width="32" Height="32" CornerRadius="{x:Bind Corner}" Visibility="{x:Bind HasArtwork}" Source="{x:Bind Artwork}" Pixels="64" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" Style="{StaticResource CardSubtitleTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="AccountButton" Padding="2" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" CornerRadius="16"
                        AutomationProperties.AutomationId="AccountButton" AutomationProperties.Name="Account and help" ToolTipService.ToolTip="Account and help">
                    <PersonPicture x:Name="AccountPicture" Width="28" Height="28" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AccountMenu" Placement="BottomEdgeAlignedRight" Opening="AccountMenu_Opening" />
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1040"
            OpenPaneLength="260"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="Nav_SelectionChanged"
            DisplayModeChanged="Nav_DisplayModeChanged"
            SizeChanged="Nav_SizeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" AutomationProperties.AutomationId="Nav-home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="New" Tag="new" AutomationProperties.AutomationId="Nav-new">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Radio" Tag="radio" AutomationProperties.AutomationId="Nav-radio">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC05;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Library" />
                <NavigationViewItem Content="Recently Added" Tag="recent" AutomationProperties.AutomationId="Nav-recent">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Songs" Tag="songs" AutomationProperties.AutomationId="Nav-songs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC4F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Albums" Tag="albums" AutomationProperties.AutomationId="Nav-albums">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Artists" Tag="artists" AutomationProperties.AutomationId="Nav-artists">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Liked Songs" Tag="liked" AutomationProperties.AutomationId="Nav-liked">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="PlaylistsHeader" Content="Playlists" />
                <!-- Playlists that don't fit: "More Playlists" in the expanded pane; in the compact pane all of them, as one item
                     whose flyout names them (their covers alone don't). -->
                <NavigationViewItem x:Name="PlaylistsGroup" Content="Playlists" SelectsOnInvoked="False" Visibility="Collapsed"
                                    AutomationProperties.Name="Playlists"
                                    AutomationProperties.AutomationId="Nav-playlists" ToolTipService.ToolTip="Playlists">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Devices" Tag="devices" AutomationProperties.AutomationId="Nav-devices">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE772;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings" AutomationProperties.AutomationId="Nav-settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="ContentArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="MainColumn">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Messages above the page: "Continue from <device>", a page that couldn't load, short notices. Never dialogs. -->
                    <StackPanel x:Name="InfoBars" Padding="28,10,28,0" Spacing="8">
                        <InfoBar x:Name="ContinueBar" AutomationProperties.AutomationId="ContinueBar" Severity="Informational" IsClosable="True"
                                 CloseButtonClick="ContinueBar_CloseButtonClick">
                            <InfoBar.IconSource><FontIconSource Glyph="&#xE8AF;" /></InfoBar.IconSource>
                            <InfoBar.ActionButton>
                                <Button x:Name="ContinuePlayHere" Content="Continue on This PC" Style="{StaticResource AccentButtonStyle}" Click="ContinuePlayHere_Click"
                                        AutomationProperties.AutomationId="ContinuePlayHere" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <!-- Signed in, but another device still has to approve this PC ("Do This Later" in the first run). -->
                        <InfoBar x:Name="ApproveBar" AutomationProperties.AutomationId="ApproveBar" Severity="Informational" IsClosable="True"
                                 CloseButtonClick="ApproveBar_CloseButtonClick">
                            <InfoBar.IconSource><FontIconSource Glyph="&#xE8D7;" /></InfoBar.IconSource>
                            <InfoBar.ActionButton>
                                <Button x:Name="ApproveBarAction" Content="Approve" Click="ApproveBarAction_Click" AutomationProperties.AutomationId="ApproveBarAction" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar x:Name="PageErrorBar" AutomationProperties.AutomationId="PageErrorBar" Severity="Warning" IsClosable="True">
                            <InfoBar.ActionButton>
                                <Button x:Name="PageErrorAction" Content="Try Again" Click="PageErrorAction_Click" AutomationProperties.AutomationId="PageErrorAction" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar x:Name="NoticeBar" AutomationProperties.AutomationId="NoticeBar" IsClosable="True" />
                    </StackPanel>
                    <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="ContentFrame_Navigated" />
                </Grid>
                <controls:SidePane
                    x:Name="SidePane"
                    Grid.Column="1"
                    Width="{StaticResource SidePaneWidth}"
                    Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <controls:NowPlayingView x:Name="NowPlaying" Grid.Row="1" Visibility="Collapsed" />

        <controls:NowPlayingBar x:Name="Bar" Grid.Row="2" />

        <!-- The first run, over everything below the title bar (Controls/OnboardingView). -->
        <controls:OnboardingView x:Name="Onboarding" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Page>
