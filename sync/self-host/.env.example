# Copy to .env and fill in. Nothing here is secret: the publishable key and issuer are public by design.
# (The admin key deploy.sh generates goes to .admin-key, readable by you only. Never put it here.)

# Your Clerk application (docs/self-hosting.md, step 1).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://verb-noun-12.clerk.accounts.dev

# The HTTPS address your devices reach the server at (step 3), e.g. https://my-box.tailnet-name.ts.net:3443.
# This is what you paste into OpenMusic. Leave it empty until you have one; deploy.sh then only checks localhost.
OPENMUSIC_SERVER_URL=

# Port on 127.0.0.1 the backend listens on.
OPENMUSIC_PORT=3210
# Port on 127.0.0.1 for the optional dashboard (--profile dashboard).
DASHBOARD_PORT=6791

# Name of this compose project (containers, volume). Change it to run a second server on the same machine.
COMPOSE_PROJECT_NAME=openmusic-sync

# Convex backend and dashboard image tag (a commit of github.com/get-convex/convex-backend). Upgrade by changing it.
CONVEX_VERSION=e631122891a73f26aa8a97ecadaf135217bd1994
