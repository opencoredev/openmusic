# Copy to scripts/local.env (gitignored) and fill in what you use. scripts/env.sh reads it; a variable already set in
# the environment wins. One NAME=value per line, no shell expansion; quotes around a value are optional.
# Scripts stop with a message naming any variable they need that is unset.

# ssh target of the Mac that builds and tests the Apple apps (scripts/mac.sh, scripts/ios.sh, the shot scripts,
# windows/scripts/swift-vectors.sh). It needs Xcode, XcodeGen and SSH key login. Example: you@build-mac.local
OPENMUSIC_MAC_HOST=

# ssh target of the Mac your iPhone is paired with and that holds your Apple Development identity
# (scripts/install-iphone.sh), and the Mac scripts/install-macbook.sh installs OpenMusic.app on.
OPENMUSIC_DEVICE_HOST=

# The iPhone to install on: its UDID (`xcrun devicectl list devices` on the device Mac).
OPENMUSIC_IPHONE_UDID=

# Signing for scripts/install-iphone.sh: the identity's name as `security find-identity -v -p codesigning` prints it
# (for example "Apple Development: you@example.com"), your Apple Team ID, and the UUID of an Xcode-managed wildcard
# provisioning profile of that team (the file name in ~/Library/Developer/Xcode/UserData/Provisioning Profiles).
OPENMUSIC_DEV_IDENTITY=
OPENMUSIC_TEAM_ID=
OPENMUSIC_PROFILE_UUID=

# ssh target of the machine where the Convex CLI is logged in and ~/agents/openmusic-sync/.env.local exists
# (scripts/convex.sh), or "local" to run Convex commands on this machine.
OPENMUSIC_CONVEX_HOST=

# Optional: path of the Windows test VM's helper script (scripts/windows-vm.sh and friends; see windows/README.md).
# Default: ~/vms/medley-win/win.sh. OPENMUSIC_VM overrides it for one run.
OPENMUSIC_WIN_VM=
